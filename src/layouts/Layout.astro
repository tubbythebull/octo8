---
// .md pages pass their frontmatter as one object; .astro pages pass props directly
const fm = Astro.props.frontmatter ?? {};
const {
	title = fm.meta_title ?? fm.title,
	description = fm.meta_description,
	keywords = [fm.primary_keyword, ...(fm.secondary_keywords ?? [])].filter(Boolean).join(', ') || undefined,
} = Astro.props;
// set no index header
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---
<!doctype html>
<html lang="en-ca">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>		
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<style>
			body {
				font-family: Arial, sans-serif;
				margin: 0;
				padding: 0;
				& > * {
					max-width: 1000px;
					margin: 0 auto;
					padding: 1.5rem;
				}
			}
			header {
				background-color: #f8f8f8;
				display: flex;
				align-items: center;
				justify-content: space-between;
				& a {
					text-decoration: none;
					color: #333;
					font-weight: bold;
				}
				& > nav ul {
					display: flex;
					gap: 1rem;
					list-style: none;
					margin: 0;
					padding: 0;
				}
			}
			section {
				& img {
					max-width: 100%;
					height: auto;
					display: block;
				}
			}
		</style>
	</head>
	<body>
		<header>
			<a href="/">Octo8</a>
			<nav>
				<ul>
					<li><a href="/services">Services</a></li>
					<li><a href="/products">Products</a></li>
					<li><a href="/contact">Contact</a></li>
				</ul>
			</nav>
		</header>
		<section>
			<slot />
		</section>
		<footer>
			<p>&copy; {new Date().getFullYear()} Christopher Betlejemski</p>
		</footer>
	</body>
</html>